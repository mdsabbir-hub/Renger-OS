ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# ── RESERVED FOR LATER PHASES (Phase 12-13 — integrations) ─────
FORTHPOINT_API_URL=
FORTHPOINT_API_KEY=
GONOAWAZ_API_URL=
GONOAWAZ_API_KEY=
