# ── REQUIRED FOR PHASE 1 ──────────────────────────────────────
# Your PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# ── RESERVED FOR LATER PHASES (Phase 5+ — AI Worker framework) ─
